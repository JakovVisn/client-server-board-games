# Copy to .env (gitignored) and fill in the training accounts.

# Server connection (train.py, play.py)
VIRUSWAR_HOST=127.0.0.1
VIRUSWAR_PORT=1234

# Training (train.py). Each env logs in with its own account; the accounts need
# the :bot flag in auth.txt and no autoLimit, so they are seekers in matchmaking.
VIRUSWAR_TRAIN_CREDENTIALS=[["rltrain_1","rltrain_1"],["rltrain_2","rltrain_2"]]
VIRUSWAR_N_ENVS=2                  # parallel envs (SubprocVecEnv); at most one per account
VIRUSWAR_TRAIN_OPPONENT=           # optional preferred opponent login; empty = league bots

# PPO
VIRUSWAR_TARGET_KL=0               # 0 = no KL early stopping
VIRUSWAR_CLIP_RANGE=0.2            # PPO policy clip range
VIRUSWAR_N_EPOCHS=10               # optimisation epochs per rollout
VIRUSWAR_ENT_COEF=0.05             # entropy bonus (exploration)

# Promotion to models/promoted/ (read by play.py)
VIRUSWAR_PROMOTE_THRESHOLD=0.55    # rollout win rate
VIRUSWAR_PROMOTE_STREAK=3          # consecutive rollouts above the threshold
VIRUSWAR_PROMOTE_COOLDOWN=20000    # steps between promotions
VIRUSWAR_PROMOTE_MIN_EP=100        # episodes in the win-rate window
VIRUSWAR_PROMOTE_KEEP=10           # promoted models kept

# play.py takes its accounts from --bot login:password:role
