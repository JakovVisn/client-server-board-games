VIRUSWAR_HOST=127.0.0.1
VIRUSWAR_PORT=1234

# Training account (env.py / train.py) — sequential, one game at a time.
# auth.txt entry must have :bot flag for instant rematch via onFinished_
VIRUSWAR_TRAIN_LOGIN=
VIRUSWAR_TRAIN_PASSWORD=
VIRUSWAR_TRAIN_OPPONENT=

# Play/inference account (play.py) — multi-game bot, handles many concurrent games.
# auth.txt entry must have :bot flag
VIRUSWAR_PLAY_LOGIN=
VIRUSWAR_PLAY_PASSWORD=
VIRUSWAR_PLAY_OPPONENT=
