# Copy to .env (gitignored). Values match the code defaults unless noted.

# Server connection
VIRUSWAR_HOST=127.0.0.1
VIRUSWAR_PORT=1234

# Parallelism
AZ_WORKERS=10               # self-play / pit worker processes (default: CPU count - 2)

# Self-play
AZ_SELF_PLAY_GAMES=40       # games generated per iteration
AZ_N_SIMS=200               # MCTS simulations per move (training)
AZ_TEMPERATURE_MOVES=20     # sub-moves with τ=1 before switching to greedy

# Training
AZ_POSITION_KEEP=0.25       # fraction of each game's positions kept (decorrelates value targets)
AZ_SAMPLE_REUSE=3           # times each kept position is sampled while buffered (sets steps/iter)
AZ_MIN_BUFFER=10000         # kept positions before training starts (~200 games)
AZ_BATCH_SIZE=256           # positions per gradient step
AZ_BUFFER_SIZE=200000       # kept positions (~4000 games)
AZ_LR=1e-3                  # Adam learning rate
AZ_WEIGHT_DECAY=1e-4        # L2 regularisation against memorising
AZ_VALUE_LOSS_WEIGHT=0.25   # loss = policy + weight * value

# Evaluation & promotion
AZ_EVAL_EVERY=5             # iterations between pit evaluations
AZ_PIT_GAMES=100            # games per pit (50 openings x both sides)
AZ_N_SIMS_PIT=100           # MCTS sims during pit
AZ_PIT_OPENING_MOVES=6      # random sub-moves that start each pit opening
AZ_PROMOTE_THRESHOLD=0.55   # win rate required to promote
AZ_VALUE_CHECK_GAMES=100    # random-play games for the value check (~20k positions)

AZ_SAVE_EVERY=5             # iterations between checkpoint saves

# Inference (play.py)
AZ_N_SIMS_PLAY=400          # MCTS sims per move during league play
AZ_SLOW_MOVE_SECS=10        # log moves slower than this
